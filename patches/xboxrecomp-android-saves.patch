+static void posix_dir_context_drop(HANDLE handle)
+{
+    AcquireSRWLockExclusive(&s_posix_dir_lock);
+    for (int i = 0; i < MAX_DIR_CONTEXTS; i++) {
+        DIR_CONTEXT *ctx = &s_dir_contexts[i];
+        if (ctx->handle == handle) {
+            if (ctx->dir)
+                closedir(ctx->dir);
+            memset(ctx, 0, sizeof(*ctx));
+            break;
+        }
+    }
+    ReleaseSRWLockExclusive(&s_posix_dir_lock);
+}
 
