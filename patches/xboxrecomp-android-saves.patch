+static BOOL posix_translate_obj_path(PXBOX_OBJECT_ATTRIBUTES attributes,
+                                    char *path, DWORD size)
+{
+    const char *name = get_xbox_path(attributes);
+    if (!name)
+        return FALSE;
+    if (attributes->RootDirectory && name[0] != '\\' && !(name[0] && name[1] == ':')) {
+        const char *dir = w32_handle_path(attributes->RootDirectory);
+        int n;
+        char *p;
+        if (!dir)
+            return FALSE;
+        n = snprintf(path, size, "%s/%s", dir, name);
+        if (n < 0 || (DWORD)n >= size)
+            return FALSE;
+        for (p = path + strlen(dir) + 1; *p; p++)
+            if (*p == '\\') *p = '/';
+        xbox_host_path_fix_case(path, strlen(dir));
+        return TRUE;
+    }
+    return xbox_translate_path(name, path, size);
+}
