+    if ((s_reg_n + 1) * 2 > s_reg_cap) reg_grow();
+    m = s_reg_cap - 1;
+    for (i = reg_hash(p) & m; s_reg[i] > REG_TOMB; i = (i + 1) & m) {}
+    s_reg[i] = p;
+    s_reg_n++;
