diff --git a/src/platform/win32_compat.c b/src/platform/win32_compat.c
index c1d5b44..602a202 100644
--- a/src/platform/win32_compat.c
+++ b/src/platform/win32_compat.c
@@ -799,11 +799,31 @@ DWORD SuspendThread(HANDLE h)
     return prev;
 }
 
+#if defined(__ANDROID__)
+/* Bionic has no pthread_cancel: the thread to end gets SIGUSR2, whose handler leaves it with
+ * pthread_exit -- the same asynchronous end pthread_cancel gives (no cleanup of guest locks either). */
+static void w32_terminate_handler(int sig) { (void)sig; pthread_exit(NULL); }
+static pthread_once_t w32_terminate_once = PTHREAD_ONCE_INIT;
+static void w32_terminate_install(void)
+{
+    struct sigaction sa;
+    memset(&sa, 0, sizeof(sa));
+    sa.sa_handler = w32_terminate_handler;
+    sigemptyset(&sa.sa_mask);
+    sigaction(SIGUSR2, &sa, NULL);
+}
+#endif
+
 BOOL TerminateThread(HANDLE h, DWORD exitCode)
 {
     w32_object *o = (w32_object *)h;
     if (!o || o->kind != K_THREAD) return FALSE;
+#if defined(__ANDROID__)
+    pthread_once(&w32_terminate_once, w32_terminate_install);
+    pthread_kill(o->thread, SIGUSR2);
+#else
     pthread_cancel(o->thread);
+#endif
     pthread_mutex_lock(&o->lock);
     o->exit_code = exitCode;
     o->exited    = 1;
@@ -1413,6 +1433,9 @@ VOID SecureZeroMemory(PVOID ptr, SIZE_T cnt)
 {
 #if defined(__APPLE__)
     memset_s(ptr, cnt, 0, cnt);
+#elif defined(__ANDROID__)
+    volatile unsigned char *p = (volatile unsigned char *)ptr;   /* bionic has no explicit_bzero */
+    while (cnt--) *p++ = 0;
 #else
     explicit_bzero(ptr, cnt);
 #endif
