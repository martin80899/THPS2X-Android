+{
+    uintptr_t *old = s_reg;
+    size_t cap = s_reg_cap, i;
+    s_reg_cap = cap ? cap * 2 : 4096;
+    s_reg = (uintptr_t *)calloc(s_reg_cap, sizeof(uintptr_t));
+    s_reg_n = 0;
+    for (i = 0; i < cap; i++)
+        if (old[i] > REG_TOMB) reg_put(old[i]);
+    free(old);
