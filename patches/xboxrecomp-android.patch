diff --git a/src/input/xinput_device.c b/src/input/xinput_device.c
index 4179647..7465efd 100644
--- a/src/input/xinput_device.c
+++ b/src/input/xinput_device.c
@@ -287,6 +287,38 @@ static void keyboard_state(XBOX_INPUT_STATE *pState)
  * Merging is also the better rule. A real pad keeps working -- its
  * buttons are already in pState and the keyboard only adds to them --
  * and there is no special case left to get wrong. */
+#include <SDL3/SDL_atomic.h>   /* SDL_SpinLock: the touch pad state (any thread) */
+
+static XBOX_GAMEPAD s_touch;
+static int          s_touch_on;
+static SDL_SpinLock s_touch_lock;
+
+void xbox_InputTouchState(const XBOX_GAMEPAD *g)
+{
+    SDL_LockSpinlock(&s_touch_lock);
+    if (g) s_touch = *g;
+    s_touch_on = g != NULL;
+    SDL_UnlockSpinlock(&s_touch_lock);
+}
+
+static void touch_merge(XBOX_INPUT_STATE *pState)
+{
+    XBOX_GAMEPAD t;
+    int i, on;
+    SDL_LockSpinlock(&s_touch_lock);
+    t = s_touch; on = s_touch_on;
+    SDL_UnlockSpinlock(&s_touch_lock);
+    if (!on) return;
+    pState->Gamepad.wButtons |= t.wButtons;
+    for (i = 0; i < 8; i++)
+        if (t.bAnalogButtons[i] > pState->Gamepad.bAnalogButtons[i])
+            pState->Gamepad.bAnalogButtons[i] = t.bAnalogButtons[i];
+    if (t.sThumbLX) pState->Gamepad.sThumbLX = t.sThumbLX;
+    if (t.sThumbLY) pState->Gamepad.sThumbLY = t.sThumbLY;
+    if (t.sThumbRX) pState->Gamepad.sThumbRX = t.sThumbRX;
+    if (t.sThumbRY) pState->Gamepad.sThumbRY = t.sThumbRY;
+}
+
 static void keyboard_merge(XBOX_INPUT_STATE *pState)
 {
     XBOX_INPUT_STATE kb;
@@ -574,6 +606,8 @@ DWORD xbox_InputGetState(DWORD dwPort, XBOX_INPUT_STATE *pState)
     unlock();
     if (keyboard_enabled() && (int)dwPort == (g_kbd_port >= 0 ? g_kbd_port : 0))
         keyboard_merge(pState);
+    if (dwPort == 0)
+        touch_merge(pState);
     xbox_InputScriptApply((int)dwPort, &pState->Gamepad);
     if (s_bind_suppress)   /* a press being recorded (rebinding menu) */
         memset(&pState->Gamepad, 0, sizeof pState->Gamepad);
